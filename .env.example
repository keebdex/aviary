# Copy to .env and run jobs with `uv run --env-file .env <job> ...`.
# GitHub Actions reads the same names from the repository secrets.

# Keebdex Supabase project URL and service role key
SUPABASE_URL=
SUPABASE_KEY=

# Cloudflare Images (bowerbird): account id, API token with Images edit
# access, and the delivery hash in imagedelivery.net/<hash>/...
CF_IMAGES_ACCOUNT_ID=
CF_IMAGES_API_KEY=
CF_IMAGES_ACCOUNT_HASH=

# Google service account key (bowerbird gdoc), the whole JSON on one line
GOOGLE_SERVICE_ACCOUNT=

# pelican: Cloudflare Images user token with Images read access (optional;
# account tokens can't download originals of Keebdex app uploads)
CF_IMAGES_READ_TOKEN=

# pelican: the R2 backup bucket (S3 API keys scoped to it) and a read-only
# Cloudflare API token for its lock rules (optional; without it no trash)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_API_TOKEN=
