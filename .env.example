# Copy to .env and run jobs with `uv run --env-file .env <job> ...`.
# GitHub Actions reads the same names from the repository secrets.

# Keebdex Supabase project URL and service role key
SUPABASE_URL=
SUPABASE_KEY=

# Cloudflare Images (bowerbird): account id, API token with Images edit
# access, and the delivery hash in imagedelivery.net/<hash>/...
CF_IMAGES_ACCOUNT_ID=
CF_IMAGES_API_KEY=
CF_IMAGES_ACCOUNT_HASH=
